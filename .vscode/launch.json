{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "调试当前 C 文件 (LLDB)",
      "type": "lldb",
      "request": "launch",
      "program": "${fileDirname}/${fileBasenameNoExtension}",
      "args": [],
      "cwd": "${fileDirname}",
      "preLaunchTask": "C/C++: clang 生成活动文件",
      "sourceLanguages": [
        "c"
      ],
      "terminal": "integrated",
      "stopOnEntry": false
    },
    {
      "name": "调试当前 C 文件 (cppdbg 备用)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${fileDirname}/${fileBasenameNoExtension}",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${fileDirname}",
      "externalConsole": false,
      "console": "integratedTerminal",
      "MIMode": "lldb",
      "preLaunchTask": "C/C++: clang 生成活动文件",
      "setupCommands": [
        {
          "description": "启用 lldb 整齐打印",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}